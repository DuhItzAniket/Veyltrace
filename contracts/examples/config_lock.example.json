{
  "schema_version": "0.1.0",
  "sections": {
    "anomara": {
      "nsigma": {
        "threshold": 3.0
      },
      "robust_z": {
        "eta": 0.02,
        "iqr_divisor": 1.349,
        "mad_factor": 1.4826,
        "min_baseline_steps": 5,
        "persist_steps": 3,
        "threshold": 3.0
      }
    },
    "causalith": {
      "entry": {
        "exclude": [
          "load-generator",
          "loadgenerator",
          "locust"
        ],
        "hints": {
          "ob": [
            "frontend"
          ],
          "otel": [
            "frontend-proxy"
          ],
          "ss": [
            "front-end"
          ],
          "tt": [
            "ts-ui-dashboard"
          ]
        }
      },
      "graph": {
        "external_min_calls": 10,
        "include_external": true
      },
      "node_kinds": {
        "cache_patterns": [
          "redis",
          "memcached",
          "valkey"
        ]
      }
    },
    "causatrix": {
      "fusion": {
        "method": "rrf"
      },
      "rankers": {
        "enabled": [
          "baro_rs",
          "change_prox",
          "cp_sbfl",
          "graph_walk",
          "nsigma",
          "prism_m"
        ]
      },
      "rrf": {
        "gate": true,
        "k": 60
      },
      "slate": {
        "k": 5
      }
    },
    "causentra": {
      "alpha": 0.1,
      "calibration": {
        "family": null,
        "family_map": {
          "re2-*": "rcaeval-re2",
          "synth": "synth"
        },
        "fold": "foldA"
      },
      "mandatory": [
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "status": {
        "c_high": 0.3,
        "c_med": 0.15
      }
    },
    "causivra": {
      "card": {
        "evidence_max": 20
      },
      "narration": {
        "enabled": true,
        "max_attempts": 2,
        "max_sentences": 5,
        "scope": "summary"
      },
      "signing": {
        "enabled": false,
        "public_key_path": null
      },
      "why_not": {
        "max": 3
      }
    },
    "causync": {
      "align": {
        "max_lag_s": 120,
        "min_corr": 0.5,
        "min_pairs": 30,
        "trace_min_offset_ms": 5
      },
      "changes": {
        "kinds": [
          "deploy",
          "config",
          "flag",
          "scale",
          "restart",
          "commit"
        ]
      }
    },
    "core": {
      "alert": {
        "protocol": "oracle",
        "reject_hint_outside_span": true,
        "shift_s": 0
      },
      "thresholds": {
        "anomaly_z": 3.0
      },
      "universe": {
        "include_external": false
      },
      "windows": {
        "baseline_s": [
          -1200,
          -120
        ],
        "incident_s": [
          -120,
          480
        ]
      }
    },
    "faultloom": {
      "atoms": {
        "detectors": [
          "robust_z",
          "nsigma",
          "silence"
        ],
        "disabled": []
      },
      "spectrum": {
        "formula": "ochiai",
        "weighting": "critical_path"
      },
      "templates": {
        "min_count": 3
      },
      "window": {
        "score_ms": 300000
      }
    },
    "infralume": {
      "events": {
        "overlay_path": null
      },
      "normalise": {
        "component_suffixes": [
          "-db"
        ],
        "drop_containers": [
          "istio-proxy",
          "istio-init",
          "POD"
        ]
      },
      "sources": {
        "drop": []
      }
    },
    "llm": {
      "base_url": "http://127.0.0.1:11434",
      "model": {
        "fallback_name": "qwen3.5:4b",
        "gguf_sha256": null,
        "name": "qwen3.5:9b"
      },
      "provider": "ollama"
    },
    "relentra": {
      "brief": {
        "max_proposals": 3,
        "max_repairs": 1
      },
      "budget": {
        "max_hypotheses": 5
      },
      "cards": {
        "k": 6,
        "k_min": 3
      },
      "enabled": true,
      "mode": "brief"
    },
    "signalyth": {
      "buckets": {
        "logs_s": 10,
        "traces_s": 10
      },
      "metrics": {
        "counter_name_patterns": [
          "_total$",
          "_count$",
          "_sum$",
          "_bucket$"
        ],
        "counter_shape_test": true
      }
    }
  },
  "calibration": null
}
