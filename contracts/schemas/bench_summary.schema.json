          "minimum": 0
        }
      }
    },
    "summary_metric_no_fault_rates": {
      "description": "NO_FAULT rates (04 §7; R-12, SC-4): false alarms over the group's normal rows (no truth: normal windows, no-fault cases), wrong NO_FAULT over its fault rows, and precision and recall of NO_FAULT over all its rows. Each null when its denominator is 0 or the method has no verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_fold",
        "false_alarm_rate",
        "n_fault",
        "n_normal",
        "no_fault_precision",
        "no_fault_recall",
        "wrong_no_fault_rate"
      ],
      "properties": {
        "false_alarm_rate": {
          "description": "Share of normal rows whose status is not NO_FAULT.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n_normal": {
          "description": "Normal rows of the group (rows without a truth).",
          "type": "integer",
          "minimum": 0
        },
        "wrong_no_fault_rate": {
          "description": "Share of fault rows whose status is NO_FAULT.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n_fault": {
          "description": "Fault rows of the group (rows with a truth).",
          "type": "integer",
          "minimum": 0
        },
        "no_fault_precision": {
          "description": "Share of normal rows among the rows declared NO_FAULT.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "no_fault_recall": {
          "description": "Share of normal rows declared NO_FAULT (1 − false_alarm_rate).",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "by_fold": {
          "description": "False-alarm rate per fold of the group's rows, sorted by fold; rows with a null fold are not held out and are not listed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_fold_no_fault"
          },
          "x-sort": [
            {
              "pointer": "fold",
              "order": "asc"
            }
          ]
        }
      }
    },
    "summary_fold_no_fault": {
      "description": "The false-alarm rate over one fold's normal rows.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false_alarm_rate",
        "fold",
        "n_normal"
      ],
      "properties": {
        "fold": {
          "description": "The fold, as bench_result.fold.",
          "type": "string",
          "minLength": 1
        },
        "false_alarm_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n_normal": {
          "description": "Normal rows of the fold.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary_metric_risk_coverage": {
      "description": "Area under the risk–coverage curve over the group's fault rows (04 §7; H3c): the mean over prefixes of the error (1 − AC@1) among the answered, with the rows ordered by the verified score V (status CONFIRMED > LIKELY > INCONCLUSIVE > NO_FAULT > none, then confidence margin desc) or by the fused score F of the verdict's leader (desc). Ties count at their expectation over the tied orders. Each null when n_fault is 0 or the method has no verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aurc_fused",
        "aurc_verdict",
        "n_fault"
      ],
      "properties": {
        "aurc_verdict": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "aurc_fused": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n_fault": {
          "description": "Fault rows of the group (rows with a truth).",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary_metric_selective_accuracy": {
      "description": "AC@1 among the group's fault rows declared CONFIRMED, and among those declared CONFIRMED or LIKELY, with their shares of the fault rows (04 §7 Selective accuracy; H4b). The answer rates are null when n_fault is 0 or the method has no verdict, the accuracies also when no row has that status.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ac_at_1_confirmed",
        "ac_at_1_likely_or_better",
        "answer_rate_confirmed",
        "answer_rate_likely_or_better",
