          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n_pairs": {
          "description": "(case, seed) with an unplanted row and at least one plant-<i> row.",
          "type": "integer",
          "minimum": 0
        }
      }
