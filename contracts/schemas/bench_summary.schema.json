      ],
      "properties": {
        "ac_at_1_confirmed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "answer_rate_confirmed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "ac_at_1_likely_or_better": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "answer_rate_likely_or_better": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n_fault": {
          "description": "Fault rows of the group (rows with a truth).",
          "type": "integer",
          "minimum": 0
        }
      }
