    "summary_interval": {
      "description": "The 95% percentile cluster-bootstrap interval of one case-mean metric of one group (04 §8).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "estimate",
        "high",
        "low",
        "method",
        "metric",
        "n_cases",
        "n_clusters",
        "system"
      ],
      "properties": {
        "dataset": {
          "$ref": "https://veyltrace.dev/schemas/1.0/common.schema.json#/$defs/dataset"
        },
        "system": {
          "description": "The system; null for a result pooled over the experiment's dataset parts of one benchmark (system as stratum, 04 §8), whose dataset is then the benchmark: the parts' name before the first '-', e.g. re2 for re2-ob, re2-ss and re2-tt.",
          "anyOf": [
            {
              "$ref": "https://veyltrace.dev/schemas/1.0/common.schema.json#/$defs/system"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "description": "Method id from the experiment YAML (04 §4).",
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "$ref": "#/$defs/summary_case_metric"
        },
        "estimate": {
          "description": "The case-weighted mean, as in the group's metrics entry.",
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "n_cases": {
          "type": "integer",
          "minimum": 1
        },
        "n_clusters": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "summary_comparison": {
      "description": "One paired difference A − B on one metric over the cases both methods scored (04 §8).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "difference",
        "family",
        "high",
        "holm_p",
        "kind",
        "low",
        "margin",
        "mcnemar_only_a",
        "mcnemar_only_b",
        "mcnemar_p",
        "method_a",
        "method_b",
        "metric",
        "n_clusters",
        "n_pairs",
        "sign_flip_p",
        "system"
      ],
      "properties": {
        "dataset": {
          "$ref": "https://veyltrace.dev/schemas/1.0/common.schema.json#/$defs/dataset"
        },
        "system": {
          "description": "The system; null for a result pooled over the experiment's dataset parts of one benchmark (system as stratum, 04 §8), whose dataset is then the benchmark: the parts' name before the first '-', e.g. re2 for re2-ob, re2-ss and re2-tt.",
          "anyOf": [
            {
              "$ref": "https://veyltrace.dev/schemas/1.0/common.schema.json#/$defs/system"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric": {
          "$ref": "#/$defs/summary_case_metric"
        },
        "method_a": {
          "description": "Method id from the experiment YAML (04 §4).",
          "type": "string",
          "minLength": 1
        },
        "method_b": {
          "description": "Method id from the experiment YAML (04 §4).",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "noninferiority (decided by the unadjusted CI and margin), superiority (a test, Holm within family), exploratory (unadjusted, labelled exploratory; 04 §8).",
          "enum": [
            "exploratory",
            "noninferiority",
            "superiority"
          ]
        },
        "family": {
          "description": "The experiment's statistics.holm_family for a superiority test in it; null for non-inferiority and exploratory comparisons.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "margin": {
          "description": "Non-inferiority margin of the paired difference (0 for H1a and H2a, 04 §2); null otherwise.",
          "type": [
            "number",
            "null"
          ]
        },
        "n_pairs": {
          "description": "Cases with a scored row with a truth for both methods.",
          "type": "integer",
          "minimum": 0
        },
        "n_clusters": {
          "type": "integer",
          "minimum": 0
        },
        "difference": {
          "description": "Case-weighted mean of A − B; null when n_pairs is 0.",
          "type": [
            "number",
            "null"
          ]
        },
        "low": {
          "description": "The difference's cluster-bootstrap interval; null when n_pairs is 0 or the interval is not run (not_run says why).",
          "type": [
            "number",
            "null"
          ]
        },
        "high": {
          "type": [
            "number",
            "null"
          ]
        },
        "sign_flip_p": {
          "description": "Two-sided cluster sign-flip p-value (04 §8 primary test).",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "mcnemar_only_a": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mcnemar_only_b": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mcnemar_p": {
          "description": "Exact McNemar p-value on case-level discordant pairs; null when statistics.mcnemar is false or hits are not boolean (seed-averaged arms).",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "holm_p": {
          "description": "Holm-adjusted p-value within family; null when family is null or a member is not run (not_run says which).",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "summary_statistics": {
      "description": "04 §8 statistics of the experiment: intervals per group, paired comparisons, and what is not run and why.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparisons",
        "intervals",
        "not_run",
        "params"
      ],
      "properties": {
        "params": {
          "description": "The experiment's statistics settings (04 §8, §9).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bootstrap_seed",
            "cluster_by",
            "flips",
            "level",
            "permutation_seed",
            "resamples"
          ],
          "properties": {
            "level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "resamples": {
              "type": "integer",
              "minimum": 1
            },
            "bootstrap_seed": {
              "type": "integer",
              "minimum": 0
            },
            "flips": {
              "type": "integer",
              "minimum": 1
            },
            "permutation_seed": {
              "type": "integer",
              "minimum": 0
            },
            "cluster_by": {
              "description": "Cluster key, fields joined by '/' (04 §8).",
              "const": "system/root_service/fault"
            }
          }
        },
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_interval"
          },
          "x-sort": [
            {
              "pointer": "dataset",
              "order": "asc"
            },
            {
              "pointer": "system",
              "order": "asc",
              "nulls": "first"
            },
            {
              "pointer": "method",
              "order": "asc"
            },
            {
              "pointer": "metric",
              "order": "asc"
            }
          ]
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary_comparison"
          },
          "x-sort": [
            {
              "pointer": "dataset",
              "order": "asc"
            },
            {
              "pointer": "system",
              "order": "asc",
              "nulls": "first"
            },
            {
              "pointer": "metric",
              "order": "asc"
            },
            {
              "pointer": "method_a",
              "order": "asc"
            },
            {
              "pointer": "method_b",
              "order": "asc"
            },
            {
              "pointer": "kind",
              "order": "asc"
            }
          ]
        },
        "not_run": {
          "description": "What 04 §8 asks for that this summary does not hold, and why.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "scope"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "x-sort": [
            {
              "pointer": "scope",
              "order": "asc"
            }
          ]
        }
      }
    }
  }
}
