            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n_fault": {
          "description": "Fault rows of the fold.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary_metric_set_size": {
      "description": "Mean, nearest-rank median and singleton share of the set size over the group's fault rows with a set_size (04 §7 Set size; H3b); each null when n_set is 0.",
